+		private static float GetPs2LipSyncGain(AudioClip audioClip, int framesPerChunk, int numChunks)
+		{
+			const int chunksPerRead = 16;
+			const int minimumActiveChunks = 5;
+			const float maximumGain = 2f;
+			const float targetSpeechPeak = .50f;
+
+			if (numChunks < minimumActiveChunks)
+			{
+				return 1f;
+			}
+
+			int samplesPerChunk = framesPerChunk * audioClip.channels;
+			var chunkPeaks = new float[numChunks];
+			var samples = new float[Math.Min(chunksPerRead, numChunks) * samplesPerChunk];
+
+			try
+			{
+				for (int first = 0; first < numChunks; first += chunksPerRead)
+				{
+					int chunksToRead = Math.Min(chunksPerRead, numChunks - first);
+					if (chunksToRead * samplesPerChunk != samples.Length)
+					{
+						samples = new float[chunksToRead * samplesPerChunk];
+					}
+
+					audioClip.GetData(samples, first * framesPerChunk);
+					for (int chunk = 0; chunk < chunksToRead; chunk++)
+					{
+						int start = chunk * samplesPerChunk;
+						float peak = 0f;
+						for (int sample = start; sample < start + samplesPerChunk; sample++)
+						{
+							if (samples[sample] > peak)
+							{
+								peak = samples[sample];
+							}
+						}
+						chunkPeaks[first + chunk] = peak;
+					}
+				}
+			}
+			catch (Exception)
+			{
+				return 1f;
+			}
+
+			Array.Sort(chunkPeaks);
+
+			// Ignore most pauses and background noise when estimating the speech level.
+			float activityFloor = Math.Max(.025f, .12f * chunkPeaks[numChunks - 1]);
+			int firstActive = Array.BinarySearch(chunkPeaks, activityFloor);
+			if (firstActive < 0)
+			{
+				firstActive = ~firstActive;
+			}
+			else
+			{
+				while (firstActive > 0 && chunkPeaks[firstActive - 1] >= activityFloor)
+				{
+					firstActive--;
+				}
+			}
+
+			int activeCount = numChunks - firstActive;
+			if (activeCount < minimumActiveChunks)
+			{
+				return 1f;
+			}
+
+			float speechPeak = chunkPeaks[firstActive + (int)(.80 * (activeCount - 1))];
+			float gain = Math.Min(maximumGain, targetSpeechPeak / speechPeak);
+
+			// Limit how many frames can newly reach the default fully open expression.
+			float sustainedPeak = chunkPeaks[(int)(.85 * (numChunks - 1))];
+			if (sustainedPeak > 0f)
+			{
+				gain = Math.Min(gain, DefaultFullOpenThreshold / sustainedPeak);
+			}
+
+			return Math.Max(1f, gain);
+		}
